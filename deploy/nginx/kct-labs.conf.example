# Nginx reverse proxy for KCT Labs (host machine). Copy to /etc/nginx/sites-available/kct-labs.conf,
# replace CHANGE_ME_DOMAIN, symlink into sites-enabled, then: sudo nginx -t && sudo systemctl reload nginx
# Certificates: sudo certbot --nginx -d CHANGE_ME_DOMAIN   (Let's Encrypt, auto-renew via systemd timer)

upstream kct_labs_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name CHANGE_ME_DOMAIN;
    # Let certbot answer ACME challenges, redirect everything else to HTTPS.
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name CHANGE_ME_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/CHANGE_ME_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CHANGE_ME_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # Security headers (CSP intentionally omitted: Payload admin uses inline scripts/styles).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Payload media uploads (Media collection allows images up to ~12 MB).
    client_max_body_size 20m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";
    proxy_read_timeout 60s;

    # Hashed build assets never change → cache for a year at the edge/browser.
    location /_next/static/ {
        proxy_pass http://kct_labs_app;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location / {
        proxy_pass http://kct_labs_app;
    }
}
