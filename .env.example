# Postgres connection string (this project uses @payloadcms/db-postgres)
DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Set to "true" on staging/preview deployments: adds noindex meta and a Disallow-all robots.txt
DISALLOW_INDEXING=false

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX, from GA Admin → Data streams → the web stream).
# NOT the numeric "Stream ID". Leave empty to disable. Loaded only in production builds, never in
# preview/draft mode or when DISALLOW_INDEXING=true. Read at BUILD time → redeploy after changing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# App quick-view popup on cards. Off by default: "View details" opens the full page.
# Set QUICK_VIEW_CARDS=true to bring the popup back; QUICK_VIEW_ENABLED=false is a master kill-switch.
# Read at BUILD time (pages are static), so change it in the env file and redeploy.
QUICK_VIEW_CARDS=false
QUICK_VIEW_ENABLED=true
